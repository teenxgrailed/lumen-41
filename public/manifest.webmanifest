{
  "name": "Needt: AI Planner, Tasks, Docs",
  "short_name": "Needt",
  "id": "/today",
  "description": "Needt is the place you keep everything you're working on: calendars, tasks, documents, mail, boards and habits, in one place.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#141416",
  "theme_color": "#141416",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/needt-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "short_name": "New task",
      "description": "Add a task",
      "url": "/today?launch=new-task",
      "icons": [
        {
          "src": "/icons/shortcut-new-task.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's plan",
      "url": "/today",
      "icons": [
        {
          "src": "/icons/shortcut-today.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ask Needt",
      "short_name": "Ask",
      "description": "Ask Needt anything about your plan",
      "url": "/today?launch=ask",
      "icons": [
        {
          "src": "/icons/shortcut-ask.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/plain"]
        }
      ]
    }
  }
}
