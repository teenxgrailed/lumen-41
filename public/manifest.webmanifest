{
  "name": "Needt: Everything you're working on, in one place",
  "short_name": "Needt",
  "id": "/today",
  "description": "Needt is the place you keep everything you're working on: calendars, tasks, documents, mail, boards and habits, in one place.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0E0E10",
  "theme_color": "#0E0E10",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/needt-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "url": "/today",
      "description": "Open today's plan"
    },
    {
      "name": "Calendar",
      "url": "/calendar",
      "description": "Open today's schedule"
    },
    {
      "name": "Focus",
      "url": "/focus",
      "description": "Start a focus session"
    },
    {
      "name": "Tasks",
      "url": "/tasks",
      "description": "Open open tasks"
    }
  ]
}
