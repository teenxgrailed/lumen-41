# Database Configuration
DATABASE_URL="postgresql://fluid:fluid@localhost:5432/fluid_calendar"
DIRECT_URL="postgresql://fluid:fluid@localhost:5432/fluid_calendar"

# NextAuth Configuration
# Use domain in production, localhost for development
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

CRON_SECRET="replace-with-random-cron-secret"

# Async calendar sync and realtime updates
REDIS_URL="redis://localhost:6379"
# Required in production so rate-limit identifiers are never stored raw.
RATE_LIMIT_HASH_SECRET="replace-with-a-separate-random-secret"
# Short-lived Page collaboration tokens. Use a distinct random secret in production.
COLLABORATION_SECRET="replace-with-random-collaboration-secret"
COLLABORATION_PUBLIC_URL="ws://localhost:1234"
COLLABORATION_PORT="1234"
# Defaults to NEXTAUTH_URL when omitted.
WEBHOOK_BASE_URL="http://localhost:3000"

# Server, edge, worker, and collaboration Sentry telemetry (runtime).
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
# Browser telemetry is public configuration baked into the Next.js build.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"
# Todoist import (optional). Redirect URL: <NEXTAUTH_URL>/api/imports/todoist/callback
TODOIST_CLIENT_ID=""
TODOIST_CLIENT_SECRET=""
# Notion import (optional). Redirect URI: <NEXTAUTH_URL>/api/imports/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_CUSTOM_URL=""
AI_ENCRYPTION_KEY=""
NEEDT_AI_API_KEY=""
# Leave both empty to use OpenRouter and the default model, which the Privacy
# Notice promises: US/EU hosts only, no retention (src/services/ai/usage.ts).
# Another base URL bypasses that routing.
NEEDT_AI_MODEL=""
NEEDT_AI_BASE_URL=""
NEEDT_AI_MONTHLY_ACTION_CAP="300"
NEEDT_AI_LIFETIME_ACTION_CAP="3000"
NEEDT_AI_CEILING_MULTIPLIER="2"
NEEDT_ALERT_EMAIL=""

# Creem billing (optional; the app stays on Free when omitted)
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
CREEM_PRODUCT_PRO_MONTHLY=""
CREEM_PRODUCT_PRO_YEARLY=""
CREEM_PRODUCT_LIFETIME=""
# Optional override for Creem test/self-hosted API environments.
CREEM_API_URL=""

# Web Push is enabled only when this complete, matching trio is supplied.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: worker pings this URL for an external uptime monitor.
NEEDT_HEARTBEAT_URL=""
# Optional: cookieless Umami analytics, baked into the Next.js build.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

RESEND_API_KEY=
RESEND_FROM_EMAIL=
