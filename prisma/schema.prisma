  pattern
  goal
  fact
}

enum AgentMemorySource {
  chat
  inferred
  habit
  document
  mail
}

enum MailProvider {
  GMAIL
  OUTLOOK
  IMAP
}

enum MailAccountStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  creemCustomerId       String?            @unique
  creemSubscriptionId   String?            @unique
  creemProductId        String?
  interval              String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  stripeCustomerId      String?            @unique
  stripePaymentIntentId String?            @unique // For one-time payments like lifetime access
  amount                Int? // Amount paid in cents
  discountApplied       Boolean            @default(false)
  lastCreemEventId      String?
  lastCreemEventAt      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([creemProductId])
  @@index([stripeCustomerId])
  @@index([stripePaymentIntentId])
}

model LifetimeHold {
  id              String                            @id @default(cuid())
  userId          String                            @unique
  user            User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId       String                            @unique
  creemCheckoutId String?                           @unique
  checkoutUrl     String?
  status          LifetimeCheckoutReservationStatus @default(CREATING)
  lastCheckedAt   DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@index([status, updatedAt])
  @@map("LifetimeCheckoutReservation")
}

model TrialGrant {
  id             String    @id @default(cuid())
  emailKey       String    @unique
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  startedAt      DateTime
  endsAt         DateTime
  day11ClaimedAt DateTime?
  day11SentAt    DateTime?
  day14ClaimedAt DateTime?
  day14SentAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([endsAt])
  @@index([day11SentAt, startedAt])
  @@index([day14SentAt, endsAt])
}

model CreemWebhookEvent {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String
  eventCreatedAt DateTime
  outcome        String
  receivedAt     DateTime @default(now())

  @@index([userId, eventCreatedAt])
}

model CreemSubscriptionCursor {
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creemSubscriptionId String
  lastEventId         String
  lastEventAt         DateTime
  restrictionLevel    Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@id([userId, creemSubscriptionId])
  @@index([userId, lastEventAt])
}

// Design v3 port (docs/port/01-data-map.md, M2). All additive.

/// A file on a task: either `url` (an uploaded object) or `bytes` (a small inline file).
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  mimeType  String?
  size      Int?
  bytes     Bytes?
  url       String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([userId])
}

/// When a person last opened a page; backs the per-person "Last viewed" sort.
model PageView {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId   String
  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, pageId])
  @@index([pageId])
}

/// Share a page or moodboard with someone who has no account yet; accepting
/// it creates the access grant. One table for both resources.
model ShareInvite {
  id           String    @id @default(cuid())
  resourceKind String // "page" | "moodboard"
  resourceId   String
  email        String
  role         String // "VIEWER" | "EDITOR" | "FULL_ACCESS"
  invitedById  String?
  invitedBy    User?     @relation("ShareInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([resourceKind, resourceId, email])
  @@index([email])
  @@index([invitedById])
}

/// Per-tool AI access on a page ("none" | "read" | "edit").
model PageAiAccess {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tool      String
  level     String   @default("none")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, tool])
}

/// One tile on a moodboard grid (image | link | color | note). Pins are never stored.
model MoodboardItem {
  id           String                 @id @default(cuid())
  moodboardId  String
  moodboard    Moodboard              @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  kind         String
  url          String?
  color        String?
  text         String?
  title        String?
  ratio        Float?
  colorName    String?
  source       Json?
  thumbnailUrl String?
  position     Float                  @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  comments     MoodboardItemComment[]

  @@index([moodboardId, position])
}

/// A comment on one reference of a moodboard grid (the PageComment pattern).
/// Read with viewer access, written with editor access; the author or full
/// access may resolve or delete it. Deleting the reference deletes its comments.
model MoodboardItemComment {
  id          String        @id @default(cuid())
  itemId      String
  item        MoodboardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Denormalised so the feed and the access check never join through the item.
  moodboardId String
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([itemId, createdAt])
  @@index([moodboardId, createdAt])
  @@index([authorId])
}

/// A picture uploaded to a moodboard's grid. The bytes live in the row (as
/// PageAsset does); a MoodboardItem of kind "image" points at it with
/// /api/moodboards/<board>/assets/<id>. Deleting the board deletes them.
model MoodboardAsset {
  id           String    @id @default(cuid())
  moodboardId  String
  moodboard    Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  originalName String
  mimeType     String
  size         Int
  bytes        Bytes
  createdAt    DateTime  @default(now())

  @@index([moodboardId, createdAt])
  @@index([userId])
}

/// A notification card that every producer writes to; ProactiveNudge stays
/// the dedupe and delivery log.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  body        String?
  entityKind  String?
  entityId    String?
  actions     Json?
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, dismissedAt, createdAt])
  @@index([entityKind, entityId])
}

/// Read state for the notification feed, which is assembled from existing
/// tables on request. `key` names one feed item (for example `comment:<id>`);
/// the key `*` holds "everything up to readAt is read".
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  readAt DateTime @default(now())

  @@unique([userId, key])
}

/// An MCP or API access link. Only a hash of the token is stored.
model AccessLink {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // "mcp" | "api"
  name         String
  tokenHash    String    @unique
  tokenPreview String
  scope        String?
  permission   String?
  access       String?
  projectIds   String[]  @default([])
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId, revokedAt])
}

enum ImportSource {
  todoist
  notion
}

enum ImportRunStatus {
  queued
  running
  done
  failed
  cancelled
}

enum ImportEntityType {
  project
  stage
  task
  part
  tag
  page
  database
  record
  asset
}

/// One import from another tool. The source token lives here only while the
/// run is queued or running (encrypted) and is set to null when it ends.
model ImportRun {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         ImportSource
  status         ImportRunStatus @default(queued)
  /// { total, done, skipped, failed }
  counts         Json            @default("{\"total\":0,\"done\":0,\"skipped\":0,\"failed\":0}")
  /// [{ code, message, externalId? }]
  warnings       Json[]          @default([])
  encryptedToken String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          ImportItemMap[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Which local row an external object became, so a second run updates it
/// instead of creating a duplicate.
model ImportItemMap {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          ImportSource
  externalId      String
  entityType      ImportEntityType
  localId         String
  importRunId     String?
  importRun       ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  sourceUpdatedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, source, externalId, entityType])
  @@index([importRunId])
}

// OAuth 2.1 authorization server for the remote MCP server. Opaque tokens:
// only their sha256 is stored. A client is either registered dynamically
// (RFC 7591, `kind = "dcr"`) or identified by the https URL of its client
// metadata document (`kind = "cimd"`, the URL is the client_id).
model OAuthClient {
  id                String                   @id @default(cuid())
  clientId          String                   @unique
  kind              String
  name              String
  redirectUris      String[]
  clientUri         String?
  logoUri           String?
  metadataFetchedAt DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  codes             OAuthAuthorizationCode[]
  tokens            OAuthToken[]

  @@index([kind, lastUsedAt])
}

/// Single use, 60 seconds, bound to the PKCE challenge, redirect and resource.
model OAuthAuthorizationCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String
  workspaceId   String?
  familyId      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId])
}

/// Access (1 h) and refresh (30 d) tokens. Every token issued from one
/// authorization shares a familyId; a refresh token used twice revokes it.
model OAuthToken {
  id          String      @id @default(cuid())
  tokenHash   String      @unique
  type        String
  familyId    String
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  resource    String
  workspaceId String?
  expiresAt   DateTime
  rotatedAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([clientId])
}

// Admin panel: one row per change an admin made to another person's account.
// No foreign keys on purpose: the row must outlive the account it records
// (deleting an account is one of the actions), so both ids are plain text and
// `details` carries the target's email at the time.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}
