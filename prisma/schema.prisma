  @@index([pageId, createdAt])
}

model MeetingNoteProposal {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  pageId          String
  page            Page                  @relation(fields: [pageId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?                 @relation("MeetingNoteProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  summary         String
  actions         Json
