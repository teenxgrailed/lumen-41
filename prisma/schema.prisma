  @@index([provider])
}

model AgentMemory {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind        AgentMemoryKind
  content     String
  source      AgentMemorySource @default(chat)
  weight      Float             @default(1)
  /// Stable key of a memory Needt computes or extracts (habit:peak-hours); null for stated ones.
  sourceKey   String?
  /// Numbers behind a computed memory (e.g. the duration ratio); never user text.
  data        Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  lastUsedAt  DateTime          @default(now())

  @@index([workspaceId, userId, lastUsedAt])
  @@index([workspaceId, userId, weight])
  @@index([userId, lastUsedAt])
  @@index([userId, weight])
  @@index([workspaceId, userId, sourceKey])
}

/// One agent session that changed data: a chat turn, a background job, or an
/// MCP/connector call batch. Groups AgentAction rows so they undo together.
model AgentRun {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       String // user | agent | mcp
  source      String // chat | background | mcp
  status      String        @default("running") // running | finished | failed | undone
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?
  actions     AgentAction[]

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

/// One applied operation from src/services/ops. The inverse is computed and
/// stored when the operation is applied; targetVersions holds the updatedAt
/// of every row it touched, so undo can refuse to overwrite later changes.
model AgentAction {
  id             String    @id @default(cuid())
  runId          String?
  run            AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor          String // user | agent | mcp
  op             String
  input          Json
  before         Json?
  inverse        Json?
  targetVersions Json      @default("[]")
  status         String    @default("applied") // applied | undoing | undone | undo_conflict | failed
  undoableUntil  DateTime?
  undoneAt       DateTime?
  undoneVersions Json?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@index([workspaceId, createdAt])
}

model AiUsage {
  id           String   @id @default(cuid())
