model PagePublication {
  id            String         @id @default(cuid())
  pageId        String         @unique
  page          Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  token         String         @unique
  publishedById String?
  publishedBy   User?          @relation("PagePublicationPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime       @default(now())
  revokedAt     DateTime?
  updatedAt     DateTime       @updatedAt
  role          PageAccessRole @default(VIEWER)

  @@index([revokedAt])
  @@index([publishedById])
}

/// A workspace-scoped collaborative visual board. Canvas behavior is added by
/// plan 05.1; access and realtime state live here so authorization is never
/// inferred from a room ID.
model Moodboard {
  id                     String                       @id @default(cuid())
  workspaceId            String
  workspace              Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdById            String?
  createdBy              User?                        @relation("MoodboardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                  String                       @default("Untitled Moodboard")
  archivedAt             DateTime?
  accessGrants           MoodboardAccessGrant[]
  collaborationState     MoodboardCollaborationState?
  snapshots              MoodboardSnapshot[]
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  // Design v3: project, link share, the linked Pinterest board, Trash, grid items.
  projectId              String?
  project                Project?                     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  linkShare              Boolean                      @default(false)
  /// Mixed into the public link's token; bumped when sharing is turned off, so an old address never comes back.
  linkTokenVersion       Int                          @default(0)
  pinterestBoardId       String?
  pinterestStatus        String?
  pinterestSyncedAt      DateTime?
  /// "Keep in sync": the daily worker pass appends new Pins; it never deletes.
  pinterestSync          Boolean                      @default(false)
  /// Whose Pinterest grant the sync reads with.
  pinterestConnectedById String?
  /// Pin ids already imported, so a Pin the person removed is not added back.
  pinterestSeen          String[]                     @default([])
  trashedAt              DateTime?
  items                  MoodboardItem[]
  assets                 MoodboardAsset[]

  @@index([workspaceId, archivedAt])
  @@index([createdById])
  @@index([projectId])
}

model MoodboardAccessGrant {
  id          String              @id @default(cuid())
  moodboardId String
  moodboard   Moodboard           @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation("MoodboardAccessGrantee", fields: [userId], references: [id], onDelete: Cascade)
  role        MoodboardAccessRole
  grantedById String?
  grantedBy   User?               @relation("MoodboardAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([moodboardId, userId])
  @@index([userId, role])
  @@index([grantedById])
}

model MoodboardCollaborationState {
  id             String    @id @default(cuid())
  moodboardId    String    @unique
  moodboard      Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  state          Bytes
  lastSnapshotAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([updatedAt])
}

model MoodboardSnapshot {
  id          String    @id @default(cuid())
  moodboardId String
  moodboard   Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  scene       Json
  createdAt   DateTime  @default(now())

  @@index([moodboardId, createdAt])
}

model AiPageChangeProposal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId     String
