// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConnectedAccount {
  id             String         @id @default(cuid())
  provider       String // "GOOGLE" | "OUTLOOK" | "CALDAV"
  email          String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  calendars      CalendarFeed[]
  mailAccounts   MailAccount[]
  // CalDAV specific fields
  caldavUrl      String? // Base URL for CalDAV server
  caldavUsername String? // Username for Basic Auth

  // User relationship
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  TaskProvider TaskProvider[]

  // Account identity is scoped by server URL for CalDAV so a user can connect
  // multiple CalDAV servers (even with the same username). For OAuth providers
  // caldavUrl is null; the migration creates this index with NULLS NOT DISTINCT
  // (a Prisma-schema-unexpressible Postgres feature) so null URLs are treated as
  // equal and OAuth stays one-account-per-(userId, provider, email). See the
  // migration `20260622130000_caldav_account_unique_by_server_url` and issue #145.
  //
  // IMPORTANT: provision the database with `prisma migrate deploy` (as this repo
  // does), NOT `prisma db push`. `db push` builds this index from the schema DSL,
  // which cannot express NULLS NOT DISTINCT, so it would treat null caldavUrl as
  // distinct and silently allow duplicate OAuth (Google/Outlook) accounts.
  // Design v3: declined / all-day / write-back sync choices.
  syncOptions Json?

  @@unique([userId, provider, email, caldavUrl], map: "ConnectedAccount_userId_provider_email_caldavUrl_key")
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                    @id @default(cuid())
  isActive               Boolean                   @default(true)
  name                   String?
  email                  String?                   @unique
  emailVerified          DateTime?
  image                  String?
  role                   String                    @default("user") // Possible values: "user", "admin"
  // Needt design: a person's own hue/initials, the same way a project owns
  // its hue (see NeedtPerson in src/lib/needt/types.ts). Nullable because most
  // users predate this and get no fallback color baked into the database.
  hue                    String?
  initials               String?
  lastAuthenticatedAt    DateTime?
  // When the account was created. Null for accounts that predate the column
  // and had no trial grant to date them by; new rows get the insert time.
  createdAt              DateTime?                 @default(now())
  // When the first-run examples were created for this account (or, for an
  // account that predates them, the migration that added the column). Set
  // once, in the transaction that creates them, so it stays set after
  // "Clear examples" and they are never created twice.
  sampleSeededAt         DateTime?
  // Bumped to sign the person out everywhere: a session token carries the
  // version it was issued under and stops working once the two differ.
  sessionVersion         Int                       @default(0)
  dataExports            DataExportRequest[]
  deletionRequest        AccountDeletionRequest?
  reauthentications      AccountReauthentication[]
  subscription           Subscription?
  lifetimeHold           LifetimeHold?
  trialGrant             TrialGrant?
  accounts               Account[]
  sessions               Session[]
  calendars              CalendarFeed[]
  autoScheduleSettings   AutoScheduleSettings?
  userSettings           UserSettings?
  calendarSettings       CalendarSettings?
  notificationSettings   NotificationSettings?
  customizationSettings  UserCustomization?
  integrationSettings    IntegrationSettings?
  dataSettings           DataSettings?
  schedulingPreferences  SchedulingPreferences?
  workSchedules          WorkSchedule[]
  flexibleHoursOverrides FlexibleHoursOverride[]
  energyProfileWindows   EnergyProfileWindow[]
  aiSettings             AISettings?
  aiOAuthConnections     AIOAuthConnection[]
  aiOAuthStates          AIOAuthState[]
  aiConversations        AiConversation[]
  aiMessages             AiMessage[]
  agentMemories          AgentMemory[]
  agentRuns              AgentRun[]
  agentActions           AgentAction[]
  aiUsage                AiUsage[]
  connectorSettings      ConnectorSettings?
  timeEntries            TimeEntry[]
  scheduledBlocks        ScheduledBlock[]
  focusSessions          FocusSession[]
  dailyHighlights        DailyHighlight[]
  morningBriefs          MorningBrief[]
  weekFocuses            WeekFocus[]
  focusStats             FocusStats?
  tasks                  Task[]
  projects               Project[]
  connectedAccounts      ConnectedAccount[]
  mailAccounts           MailAccount[]
  mailFocusedSplits      MailFocusedSplit[]
  tags                   Tag[]
  JobRecord              JobRecord[]
  taskProviders          TaskProvider[]
  TaskChange             TaskChange[]
  PasswordReset          PasswordReset[]
  boards                 Board[]
  savedViews             SavedView[]
  dailyAgendas           DailyAgenda[]
  pages                  Page[]
  pageFolders            PageFolder[]
  pageTags               PageTag[]
  pageSmartFolders       PageSmartFolder[]
  pageRevisions          PageRevision[]
  aiPageProposals        AiPageChangeProposal[]
  pageAssets             PageAsset[]
  pageComments           PageComment[]
  moodboardItemComments  MoodboardItemComment[]
  pageAccessGrants       PageAccessGrant[]         @relation("PageAccessGrantee")
  pageAccessGrantsGiven  PageAccessGrant[]         @relation("PageAccessGrantor")
  pagePublications       PagePublication[]         @relation("PagePublicationPublisher")
  moodboardsCreated      Moodboard[]               @relation("MoodboardCreator")
  moodboardAccessGrants  MoodboardAccessGrant[]    @relation("MoodboardAccessGrantee")
  moodboardGrantsGiven   MoodboardAccessGrant[]    @relation("MoodboardAccessGrantor")
  pageTemplates          PageTemplate[]
  pageFormSubmissions    PageFormSubmission[]
  bugReports             BugReport[]
  externalIntegrations   ExternalIntegration[]
  pinterestConnection    PinterestConnection?
  schedulingRuns         SchedulingRun[]
  idempotencyRecords     IdempotencyRecord[]
  creemWebhookEvents     CreemWebhookEvent[]
  creemCursors           CreemSubscriptionCursor[]
  taskDependenciesOwned  TaskDependency[]          @relation("TaskDependencyOwner")
  focusPreferences       FocusPreferences?
  taskReminders          TaskReminder[]
  proactiveNudges        ProactiveNudge[]
  pushSubscriptions      PushSubscription[]
  bookingPages           BookingPage[]
  bookings               Booking[]                 @relation("BookingOwner")
  featureFlagOverrides   FeatureFlagOverride[]
  personalWorkspace      Workspace?                @relation("PersonalWorkspaceOwner")
  workspaceMemberships   WorkspaceMember[]
  workspaceInvitesSent   WorkspaceInvite[]         @relation("WorkspaceInviteSender")
  workspaceInvitesUsed   WorkspaceInvite[]         @relation("WorkspaceInviteAcceptor")
  assignedTasks          Task[]                    @relation("TaskAssignee")
  taskActivities         TaskActivity[]            @relation("TaskActivityActor")
  projectTemplates       ProjectTemplate[]         @relation("ProjectTemplateCreator")
  projectBlockersCreated ProjectBlocker[]          @relation("ProjectBlockerCreator")
  projectHealthUpdates   ProjectHealthUpdate[]     @relation("ProjectHealthUpdateAuthor")
  habits                 Habit[]
  personalBlocks         PersonalBlock[]
  weeklyFocusTargets     WeeklyFocusTarget[]
  meetingNoteProposals   MeetingNoteProposal[]     @relation("MeetingNoteProposalCreator")
  closedDays             ClosedDay[]
  oauthCodes             OAuthAuthorizationCode[]
  oauthTokens            OAuthToken[]
  taskWaitsOnMe          TaskWait[]                @relation("TaskWaitWaitingOnUser")
  // Design v3 onboarding: what the person uses Needt for, and when they finished.
  onboardingUses         String[]                  @default([])
  onboardingCompletedAt  DateTime?
  taskAttachments        TaskAttachment[]
  pageViews              PageView[]
  shareInvitesSent       ShareInvite[]             @relation("ShareInviteSender")
  moodboardAssets        MoodboardAsset[]
  notifications          Notification[]
  notificationReads      NotificationRead[]
  accessLinks            AccessLink[]
  importRuns             ImportRun[]
  importItemMaps         ImportItemMap[]
}

model Workspace {
  id                   String                @id @default(cuid())
  name                 String
  kind                 WorkspaceKind         @default(PERSONAL)
  personalOwnerId      String?               @unique
  personalOwner        User?                 @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: SetNull)
  members              WorkspaceMember[]
  invites              WorkspaceInvite[]
  projects             Project[]
  tasks                Task[]
  boards               Board[]
  pages                Page[]
  pageFolders          PageFolder[]
  pageTags             PageTag[]
  pageSmartFolders     PageSmartFolder[]
  moodboards           Moodboard[]
  taskActivities       TaskActivity[]
  taskDependencies     TaskDependency[]
  projectTemplates     ProjectTemplate[]
  projectHealthUpdates ProjectHealthUpdate[]
  habits               Habit[]
  personalBlocks       PersonalBlock[]
  dailyHighlights      DailyHighlight[]
  weekFocuses          WeekFocus[]
  weeklyFocusTargets   WeeklyFocusTarget[]
  meetingNoteProposals MeetingNoteProposal[]
  savedViews           SavedView[]
  schedulingRuns       SchedulingRun[]
  aiConversations      AiConversation[]
  aiMessages           AiMessage[]
  agentMemories        AgentMemory[]
  importRuns           ImportRun[]
  agentRuns            AgentRun[]
  agentActions         AgentAction[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([kind])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         WorkspaceRole
  tokenHash    String        @unique
  invitedById  String?
  invitedBy    User?         @relation("WorkspaceInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedById String?
  acceptedBy   User?         @relation("WorkspaceInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  declinedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([workspaceId, email])
  @@index([email, expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum DataExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DOWNLOADED
  EXPIRED
}

model DataExportRequest {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DataExportStatus @default(PENDING)
  archive      Bytes?
  tokenHash    String?          @unique
  expiresAt    DateTime?
  downloadedAt DateTime?
  errorCode    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

enum AccountDeletionStatus {
  SCHEDULED
  CANCELED
  PROCESSING
  COMPLETED
  FAILED
}

model AccountDeletionRequest {
  id           String                @id @default(cuid())
  userId       String?               @unique
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  status       AccountDeletionStatus @default(SCHEDULED)
  scheduledFor DateTime
  canceledAt   DateTime?
  completedAt  DateTime?
  errorCode    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, scheduledFor])
}

model AccountReauthentication {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionHash     String
  challengeHash   String?   @unique
  provider        String?
  authenticatedAt DateTime?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, sessionHash, expiresAt])
  @@index([expiresAt])
}

model CalendarFeed {
  id                String            @id @default(uuid())
  name              String
  url               String? // Optional for local calendars
  type              String // "LOCAL", "GOOGLE", "OUTLOOK", "CALDAV"
  color             String? // Add back color field
  enabled           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastSync          DateTime?
  syncToken         String? // For incremental sync
  error             String?
  channelId         String? // Google Calendar webhook channel ID
  resourceId        String? // Google Calendar webhook resource ID
  channelExpiration DateTime? // When the webhook expires
  events            CalendarEvent[]
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  accountId         String?
  account           ConnectedAccount? @relation(fields: [accountId], references: [id])
  // CalDAV specific fields
  caldavPath        String? // Path to the specific calendar on the server
  ctag              String? // CalDAV collection tag for change detection
  webhooks          CalendarWebhook[]

  @@index([accountId])
}

model CalendarWebhook {
  id             String       @id @default(cuid())
  provider       String
  feedId         String
  feed           CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  channelId      String?
  subscriptionId String?
  resourceId     String?
  expiration     DateTime
  clientState    String?
  channelToken   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, feedId])
  @@index([channelId])
  @@index([subscriptionId])
}

model CalendarEvent {
  id              String       @id @default(uuid())
  feedId          String
  feed            CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalEventId String? // External Calendar Event ID (Google, Outlook, etc.)
  title           String
  description     String?
  start           DateTime
  end             DateTime
  location        String?
  isRecurring     Boolean      @default(false)
  recurrenceRule  String?
  allDay          Boolean      @default(false)
  status          String?
  sequence        Int?
  created         DateTime?
  lastModified    DateTime?
  organizer       Json? // Stored as JSON { name?: string, email: string }
  attendees       Json? // Stored as JSON array of { name?: string, email: string, status?: string }
  syncStatus      String? // 'PENDING', 'SYNCED' or 'ERROR' for provider reconciliation
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  // New fields for hybrid approach
  isMaster         Boolean         @default(false) // True if this is a master event
  masterEventId    String? // Reference to the master event for instances
  masterEvent      CalendarEvent?  @relation("EventInstances", fields: [masterEventId], references: [id], onDelete: Cascade)
  instances        CalendarEvent[] @relation("EventInstances")
  recurringEventId String? // Google Calendar's recurring event ID

  @@index([feedId])
  @@index([feedId, archivedAt])
  @@index([start, end])
  @@index([externalEventId])
  @@index([masterEventId])
  @@index([recurringEventId])
}

model MailAccount {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             MailProvider
  address              String
  encryptedCredentials String?
  connectionRef        String?
  connection           ConnectedAccount? @relation(fields: [connectionRef], references: [id], onDelete: SetNull)
  status               MailAccountStatus @default(ACTIVE)
  syncCursor           String?
  lastSyncAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  messages             MailMessage[]

  @@unique([userId, provider, address])
  @@index([userId])
  @@index([connectionRef])
  @@index([status])
}

model MailMessage {
  id            String      @id @default(cuid())
  accountId     String
  account       MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId    String
  threadId      String?
  fromName      String?
  fromAddress   String?
  toAddresses   Json
  subject       String
  snippet       String
  date          DateTime
  isRead        Boolean     @default(false)
  isArchived    Boolean     @default(false)
  snoozedUntil  DateTime?
  labels        Json
  bodyHtml      String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // Design v3 (mail stays read-only): Trash, cc/bcc, attachment metadata,
  // and the AI triage written at sync time.
  trashedAt     DateTime?
  ccAddresses   Json?
  bccAddresses  Json?
  attachments   Json?
  needsReply    Boolean?
  suggestedTask String?

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@index([accountId, isRead, isArchived])
  @@index([accountId, isArchived, snoozedUntil])
  @@index([accountId, trashedAt])
}

/// A private, user-owned sender rule for a focused Mail inbox. Focused splits
/// deliberately have no workspace scope or sharing model.
model MailFocusedSplit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  senderAddress String
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, senderAddress])
  @@index([userId, position])
}

model Project {
  id               String                @id @default(cuid())
  name             String
  description      String?
  color            String?
  icon             String?
  // Legacy rollback field. API responses derive progress from active tasks;
  // remove this column only in a later contract migration.
  progress         Int                   @default(0)
  status           String                @default("active") // enum: 'active', 'archived'
  tasks            Task[]
  taskListMappings TaskListMapping[]
  stages           ProjectStage[]
  blockers         ProjectBlocker[]
  habits           Habit[]
  healthStatus     ProjectHealthStatus   @default(UNKNOWN)
  healthVersion    Int                   @default(0)
  healthUpdatedAt  DateTime?
  healthUpdates    ProjectHealthUpdate[]
  startDate        DateTime?
  deadline         DateTime?
  sourceTemplateId String?
  sourceTemplate   ProjectTemplate?      @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  // External sync fields
  externalId     String?
  externalSource String?
  lastSyncedAt   DateTime?

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  // First-run example; see Task.isSample.
  isSample Boolean @default(false)

  // Metadata
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // Design v3: frame tint and manual order.
  ground     String?
  position   Float       @default(0)
  pages      Page[]
  moodboards Moodboard[]

  @@index([status])
  @@index([userId])
  @@index([workspaceId])
  @@index([sourceTemplateId])
  @@index([externalId, externalSource])
}

model ProjectStage {
  id                   String           @id @default(cuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  color                String?
  position             Float            @default(0)
  startDate            DateTime?
  deadline             DateTime?
  expectedDurationDays Int?
  tasks                Task[]
  blockers             ProjectBlocker[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([id, projectId])
  @@index([projectId, position])
}

/// A project-scoped hold. Exactly one target (task or stage) and one source
/// (blocker task or external title) are enforced by the migration checks.
model ProjectBlocker {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?         @relation("ProjectBlockerTargetTask", fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade, map: "ProjectBlocker_taskId_fkey")
  stageId       String?
  stage         ProjectStage? @relation(fields: [stageId, projectId], references: [id, projectId], onDelete: Cascade, map: "ProjectBlocker_stageId_fkey")
  blockerTaskId String?
  blockerTask   Task?         @relation("ProjectBlockerSourceTask", fields: [blockerTaskId, projectId], references: [id, projectId], onDelete: Cascade, map: "ProjectBlocker_blockerTaskId_fkey")
  title         String?
  resolvedAt    DateTime?
  createdById   String?
  createdBy     User?         @relation("ProjectBlockerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId, resolvedAt])
  @@index([taskId])
  @@index([stageId])
  @@index([blockerTaskId])
  @@index([createdById])
}

model ProjectHealthUpdate {
  id             String              @id @default(cuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  authorId       String?
  author         User?               @relation("ProjectHealthUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  status         ProjectHealthStatus
  previousStatus ProjectHealthStatus
  summary        String
  version        Int
  createdAt      DateTime            @default(now())

  @@unique([projectId, version])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([authorId])
}

model ProjectTemplate {
  id           String                      @id @default(cuid())
  workspaceId  String
  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?                       @relation("ProjectTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name         String
  description  String?
  color        String?
  icon         String?
  kind         ProjectTemplateKind         @default(REGULAR)
  stages       ProjectTemplateStage[]
  roles        ProjectTemplateRole[]
  tasks        ProjectTemplateTask[]
  dependencies ProjectTemplateDependency[]
  projects     Project[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([workspaceId, kind])
  @@index([createdById])
}

model ProjectTemplateStage {
  id              String                @id @default(cuid())
  templateId      String
  template        ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name            String
  color           String?
  position        Float                 @default(0)
  startOffsetDays Int                   @default(0)
  durationDays    Int?
  tasks           ProjectTemplateTask[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([id, templateId])
  @@index([templateId, position])
}

model ProjectTemplateRole {
  id         String                @id @default(cuid())
  templateId String
  template   ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  position   Float                 @default(0)
  tasks      ProjectTemplateTask[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([templateId, name])
  @@unique([id, templateId])
  @@index([templateId, position])
}

model ProjectTemplateTask {
  id                 String                      @id @default(cuid())
  templateId         String
  template           ProjectTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageId            String?
  stage              ProjectTemplateStage?       @relation(fields: [stageId, templateId], references: [id, templateId], onDelete: NoAction, map: "ProjectTemplateTask_stageId_fkey")
  roleId             String?
  role               ProjectTemplateRole?        @relation(fields: [roleId, templateId], references: [id, templateId], onDelete: NoAction, map: "ProjectTemplateTask_roleId_fkey")
  title              String
  description        String?
  position           Float                       @default(0)
  estimatedMinutes   Int?
  priority           String?
  energyRequired     SchedulingEnergyLevel       @default(MEDIUM)
  startAnchor        ProjectRelativeDateAnchor?
  startOffsetDays    Int?
  deadlineAnchor     ProjectRelativeDateAnchor?
  deadlineOffsetDays Int?
  blocks             ProjectTemplateDependency[] @relation("ProjectTemplateDependencyBlocker")
  blockedBy          ProjectTemplateDependency[] @relation("ProjectTemplateDependencyBlocked")
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([id, templateId])
  @@index([templateId, position])
  @@index([stageId])
  @@index([roleId])
}

model ProjectTemplateDependency {
  id            String              @id @default(cuid())
  templateId    String
  template      ProjectTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  blockerTaskId String
  blockerTask   ProjectTemplateTask @relation("ProjectTemplateDependencyBlocker", fields: [blockerTaskId, templateId], references: [id, templateId], onDelete: Cascade, map: "ProjectTemplateDependency_blockerTaskId_fkey")
  blockedTaskId String
  blockedTask   ProjectTemplateTask @relation("ProjectTemplateDependencyBlocked", fields: [blockedTaskId, templateId], references: [id, templateId], onDelete: Cascade, map: "ProjectTemplateDependency_blockedTaskId_fkey")
  createdAt     DateTime            @default(now())

  @@unique([blockerTaskId, blockedTaskId])
  @@index([templateId])
  @@index([blockedTaskId])
}

model TaskActivity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId])
}

/// A persistent, editable work journal for one local calendar day. Tasks stay
/// in Task; the agenda stores only the user's rich-text notes for that date.
model DailyAgenda {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime @db.Date
  content               String   @default("")
  documentFormatVersion Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String // enum: 'todo', 'in_progress', 'completed'

  // Time Management
  dueDate       DateTime?
  startDate     DateTime? // When the task becomes active
  duration      Int? // estimated duration in minutes
  priority      String? // enum: 'high', 'medium', 'low', 'none'
  energyLevel   String? // enum: 'high', 'medium', 'low'
  preferredTime String? // enum: 'morning', 'afternoon', 'evening'

  // Smart scheduling fields
  energyRequired        SchedulingEnergyLevel  @default(MEDIUM)
  estimatedMinutes      Int?
  estOptimistic         Int?
  estLikely             Int?
  estPessimistic        Int?
  actualMinutes         Int?
  actualFocusedMinutes  Int                    @default(0)
  estimateDelta         Int?
  optimisticDelta       Int?
  likelyDelta           Int?
  pessimisticDelta      Int?
  minChunkMinutes       Int?
  maxChunkMinutes       Int?
  deadline              DateTime?
  hardDeadline          Boolean                @default(false)
  priorityLevel         SchedulingTaskPriority @default(MEDIUM)
  contextTag            String?
  isFrozen              Boolean                @default(false)
  dependsOnId           String?
  dependsOn             Task?                  @relation("TaskDependencies", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents            Task[]                 @relation("TaskDependencies")
  blockingDependencies  TaskDependency[]       @relation("TaskDependencyBlocker")
  blockedByDependencies TaskDependency[]       @relation("TaskDependencyBlocked")
  reminders             TaskReminder[]
  proactiveNudges       ProactiveNudge[]
  autoScheduled         Boolean                @default(false)

  // Auto-scheduling
  isAutoScheduled Boolean       @default(false)
  scheduleLocked  Boolean       @default(false)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  scheduleId      String?
  schedule        WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleScore   Float?
  lastScheduled   DateTime?
  // Earliest explicit scheduling boundary. The scheduler also respects
  // startDate and postponedUntil and uses the latest of all three.
  availableFrom   DateTime?
  postponedUntil  DateTime?
  isArchived      Boolean       @default(false)
  archivedAt      DateTime?

  // Calendar block push
  blockEventId String? // Google Calendar event ID of the pushed block
  blockFeedId  String? // Calendar feed ID where event is stored
  blockDirty   Boolean @default(false) // Push failed, needs retry

  // Organization
  tags Tag[]

  // Recurrence
  isRecurring          Boolean   @default(false)
  recurrenceRule       String?
  lastCompletedDate    DateTime?
  completedAt          DateTime? // When the task was marked as completed
  recurrenceMasterId   String?
  recurrenceInstanceAt DateTime?
  recurrenceMaster     Task?     @relation("TaskRecurrenceInstances", fields: [recurrenceMasterId], references: [id], onDelete: Restrict)
  recurrenceInstances  Task[]    @relation("TaskRecurrenceInstances")

  // External Integration
  externalTaskId String?
  source         String?
  lastSyncedAt   DateTime?

  // Enhanced sync fields
  externalListId    String? // The external list/folder ID this task belongs to
  externalCreatedAt DateTime? // When the task was created in the external system
  externalUpdatedAt DateTime? // When the task was last updated in the external system
  syncStatus        String? // 'synced', 'pending', 'error', etc.
  syncError         String? // Error message if sync failed
  syncHash          String? // Hash of task data for detecting changes
  skipSync          Boolean   @default(false) // Flag to skip syncing this task

  // Change tracking relation
  changes           TaskChange[]
  timeEntries       TimeEntry[]
  scheduledBlocks   ScheduledBlock[]
  focusSessions     FocusSession[]
  dailyHighlights   DailyHighlight[]
  habit             Habit?           @relation(fields: [habitId], references: [id], onDelete: Restrict)
  habitId           String?
  habitOccurrenceAt DateTime?

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  workspaceId             String?
  workspace               Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assigneeId              String?
  assignee                User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  busyStatus              TaskBusyStatus   @default(BUSY)
  stageId                 String?
  stage                   ProjectStage?    @relation(fields: [stageId, projectId], references: [id, projectId], onDelete: NoAction, map: "Task_stageId_fkey")
  activities              TaskActivity[]
  projectBlockersTargeted ProjectBlocker[] @relation("ProjectBlockerTargetTask")
  projectBlockersAsSource ProjectBlocker[] @relation("ProjectBlockerSourceTask")

  // First-run example (src/services/onboarding): removed by "Clear examples",
  // never counted against a plan limit.
  isSample Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Boards: a task can live on one board in one column. These are additive and
  // do NOT affect the scheduling engine — a board task is the same task the
  // auto-scheduler works with. `properties` is reserved for future custom
  // fields. boardPosition is a fractional index (see @/lib/board-position).
  boardId       String?
  board         Board?       @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardColumnId String?
  boardColumn   BoardColumn? @relation(fields: [boardColumnId], references: [id], onDelete: SetNull)
  boardPosition Float?
  properties    Json?

  // Needt design: fields the new design's contract (src/lib/needt/types.ts)
  // needs and the schema did not have a column for yet. All additive; see
  // src/lib/needt/task-view.ts for how each is read (or honestly returned as
  // `null`, per the contract's three-state convention, when it still can't
  // be).
  entry                  String? // The task's two-minute first step.
  noSlot                 Boolean          @default(false) // Belongs to no day/rail.
  lastTouchedAt          DateTime? // Backs `age` without updatedAt's reschedule noise.
  previousScheduledStart DateTime? // Backs `movedFrom`: where the scheduler moved it from.
  valueCents             Int? // Money task: what it is worth, in integer cents.
  earnedCents            Int? // Money task: what has come in, in integer cents.
  globalStage            TaskStage? // Four global stages, independent of any project.
  parts                  TaskPart[]
  waits                  TaskWait[]
  // Design v3: Trash (distinct from the read-only archive), the origin
  // chip (mail | doc | chat) and "Don't split".
  trashedAt              DateTime?
  originKind             String?
  originId               String?
  originQuote            String?
  splitAllowed           Boolean          @default(true)
  attachments            TaskAttachment[]

  @@unique([recurrenceMasterId, recurrenceInstanceAt])
  @@unique([habitId, habitOccurrenceAt])
  @@unique([id, projectId])
  @@index([status])
  @@index([dueDate])
  @@index([startDate])
  @@index([priority])
  @@index([projectId])
  @@index([boardId])
  @@index([boardColumnId])
  @@index([isRecurring])
  @@index([recurrenceMasterId])
  @@index([isAutoScheduled])
  @@index([scheduledStart, scheduledEnd])
  @@index([scheduleId])
  @@index([externalTaskId])
  @@index([source])
  @@index([availableFrom])
  @@index([postponedUntil])
  @@index([deadline])
  @@index([userId, isArchived])
  @@index([energyRequired])
  @@index([priorityLevel])
  @@index([contextTag])
  @@index([isFrozen])
  @@index([dependsOnId])
  @@index([autoScheduled])
  @@index([userId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([stageId])
  @@index([externalTaskId, source])
  @@index([syncStatus])
  @@index([externalListId])
  @@index([blockDirty, userId])
  @@index([blockFeedId])
  @@index([globalStage])
  @@index([habitId, habitOccurrenceAt])
  @@index([userId, trashedAt])
  @@index([originKind, originId])
}

/// One level only — a part can be promoted to a task, never nested further
/// (src/lib/needt/types.ts TaskPart). Additive: the design's `parts` field had
/// no table at all before this.
model TaskPart {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

/// What a task is waiting on: a person, with a reason (src/lib/needt/types.ts
/// WaitsOn). A table rather than two columns on Task because `blocking()`
/// needs something groupable by person, and a task can only be waiting on one
/// person at a time in the current design, so `resolvedAt` marks history
/// rather than deleting the row.
model TaskWait {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  waitingOnUserId String
  waitingOnUser   User      @relation("TaskWaitWaitingOnUser", fields: [waitingOnUserId], references: [id], onDelete: Cascade)
  reason          String
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([taskId, resolvedAt])
  @@index([waitingOnUserId, resolvedAt])
}

/// A recurring habit (src/lib/needt/types.ts NeedtHabit). `done`, the last
/// fourteen days oldest-first, is NOT a stored array — it's a query over
/// HabitCompletion, the same way `streak()` and the rest of derive.ts treat
/// everything else that could go stale.
model Habit {
  id                       String                 @id @default(cuid())
  userId                   String
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId              String
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  title                    String
  description              String?
  targetOccurrencesPerWeek Int                    @default(1)
  daysOfWeek               Int[]                  @default([])
  estimatedMinutes         Int                    @default(30)
  energyRequired           SchedulingEnergyLevel  @default(MEDIUM)
  priority                 SchedulingTaskPriority @default(MEDIUM)
  scheduleId               String?
  schedule                 WorkSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  at                       String? // Time of day, e.g. "18:00"; null = not pinned to one.
  projectId                String?
  project                  Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quota                    Int? // Per-week quota; null = no quota.
  isActive                 Boolean                @default(true)
  archivedAt               DateTime?
  tasks                    Task[]
  completions              HabitCompletion[]
  // First-run example; see Task.isSample. Never counts toward the Free limit.
  isSample                 Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  color                    String? // Own colour; null = the project's.
  icon                     String?

  @@index([workspaceId, archivedAt, isActive])
  @@index([userId, archivedAt])
  @@index([scheduleId])
  @@index([projectId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

model WeeklyFocusTarget {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  targetMinutes Int       @default(300)
  weekStartsOn  Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// A day counts as closed when everything with a deadline on it was closed
/// (src/lib/needt/types.ts NeedtDayMark / closedDays). One row per closed day;
/// an absent row means not closed, so the fourteen-day window is also a query
/// here rather than a stored array.
model ClosedDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model TimeEntry {
  id        String          @id @default(cuid())
  taskId    String
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  source    TimeEntrySource @default(timer)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([taskId])
  @@index([userId, startedAt])
  @@index([source])
}

// Protected personal time (Lunch, Walk, Gym...): kept for the person, never
// filled by the scheduler. Stays inside Needt; never written to a provider.
// `rrule` repeats it (wall-clock in the user's time zone). `sourceEventId` links
// a synced calendar event the person marked as personal (no FK: the sync may
// remove the event; the block then keeps its own start/end). `isDefault` marks
// the repeating defaults set in Settings, one per kind.
model PersonalBlock {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind          String    @default("custom") // lunch|break|walk|dinner|gym|party|rest|custom
  title         String
  emoji         String?
  color         String? // A palette token name, never a raw colour.
  start         DateTime
  end           DateTime
  rrule         String?
  sourceEventId String?
  isDefault     Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, archivedAt, start])
  @@index([workspaceId, archivedAt])
  @@index([sourceEventId])
}

model ScheduledBlock {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  start      DateTime
  end        DateTime
  chunkIndex Int      @default(0)
  chunkCount Int      @default(1)
  isFrozen   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, chunkIndex])
  @@index([userId, start])
  @@index([taskId])
  @@index([start, end])
}

model FocusSession {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId             String?
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  mode               FocusSessionMode
  plannedMinutes     Int?
  elapsedMinutes     Int                 @default(0)
  completed          Boolean             @default(false)
  abandoned          Boolean             @default(false)
  // Server-truth timing. An active session has endedAt = null. pausedTotalSeconds
  // accumulates completed pause spans; pausedAt is set while currently paused.
  startedAt          DateTime
  endedAt            DateTime?
  pausedAt           DateTime?
  pausedTotalSeconds Int                 @default(0)
  source             String              @default("web")
  phase              FocusSessionPhase   @default(FOCUS)
  strictness         FocusStrictnessMode @default(NORMAL)
  intention          String?
  stopRequestedAt    DateTime?
  exitAttemptCount   Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([taskId])
  @@index([mode])
  @@index([completed])
}

/// The one task a person picked as the main thing of a day. One row per user,
/// workspace and day; the day is the person's own ("YYYY-MM-DD"), so no time
/// zone is guessed on the server. Additive: nothing else reads it.
model DailyHighlight {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date        String
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId, date])
  @@index([taskId])
}

/// The morning brief Ask wrote for a person's day (Pro): 2-3 lines, generated
/// at most once per user and day, cached here, dismissible. `text` is empty
/// only while the one generation for that day is running.
model MorningBrief {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  text        String
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
}

/// The up-to-three focuses a person picked in the Sunday review for the week
/// that starts on `weekStart` ("YYYY-MM-DD", the person's own first day of the
/// week). `focuses` is `[{ title, taskId? }]`; they are the first candidates
/// for that week's daily highlight.
model WeekFocus {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  weekStart   String
  focuses     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId, weekStart])
}

model FocusStats {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusScore      Int       @default(0)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lifetimeMinutes Int       @default(0)
  lastFocusDate   DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model FocusPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultMinutes          Int      @default(25)
  dailyGoalMinutes        Int      @default(25)
  shortBreakMinutes       Int      @default(5)
  longBreakMinutes        Int      @default(15)
  sessionsBeforeLongBreak Int      @default(4)
  browserNotifications    Boolean  @default(false)
  quietHoursStart         String?
  quietHoursEnd           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model SchedulingRun {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String?
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  source             SchedulingRunSource
  status             SchedulingRunStatus @default(QUEUED)
  dedupeKey          String
  changedTaskCount   Int                 @default(0)
  placedBlockCount   Int                 @default(0)
  unchangedTaskCount Int                 @default(0)
  unscheduled        Json?
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([source, status, createdAt])
}

model CronState {
  id              String    @id
  pendingCursor   String?
  completedCursor String?
  pendingUserIds  Json?
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

model IdempotencyRecord {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation String
  key       String
  status    IdempotencyStatus @default(IN_PROGRESS)
  result    Json?
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, operation, key])
  @@index([expiresAt])
}

model TaskDependency {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId        String?
  user          User?     @relation("TaskDependencyOwner", fields: [userId], references: [id], onDelete: SetNull)
  blockerTaskId String
  blocker       Task      @relation("TaskDependencyBlocker", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  blockedTaskId String
  blocked       Task      @relation("TaskDependencyBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  removedAt     DateTime?

  @@unique([blockerTaskId, blockedTaskId])
  @@index([userId, blockedTaskId])
  @@index([userId, blockerTaskId])
  @@index([workspaceId, removedAt])
}

model TaskReminder {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind           TaskReminderKind
  offsetMinutes  Int
  channels       Json
  deliveryStatus ReminderDeliveryStatus @default(PENDING)
  lastAttemptAt  DateTime?
  attemptCount   Int                    @default(0)
  lastError      String?
  deliveredAt    DateTime?
  canceledAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([taskId, kind, offsetMinutes])
  @@index([userId, deliveryStatus, deliveredAt])
}

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model ProactiveNudge {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        ProactiveNudgeType
  timeWindow  String
  dedupeKey   String
  title       String
  body        String
  deepLink    String
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, deliveredAt, readAt])
  @@index([taskId, type])
}

model FeatureFlag {
  key               String                @id
  enabled           Boolean               @default(false)
  rolloutPercentage Int                   @default(0)
  description       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  overrides         FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id        String      @id @default(cuid())
  flagKey   String
  flag      FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([flagKey, userId])
  @@index([userId])
}

model BookingPage {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String    @unique
  title              String
  description        String?
  durationMinutes    Int       @default(30)
  bufferBefore       Int       @default(0)
  bufferAfter        Int       @default(10)
  minimumNotice      Int       @default(120)
  bookingHorizonDays Int       @default(60)
  cancellationHours  Int       @default(24)
  timeZone           String    @default("UTC")
  availability       Json
  isActive           Boolean   @default(true)
  bookings           Booking[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, isActive])
}

model Booking {
  id              String        @id @default(cuid())
  bookingPageId   String
  bookingPage     BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User          @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guestName       String
  guestEmail      String
  start           DateTime
  end             DateTime
  timeZone        String
  status          BookingStatus @default(CONFIRMED)
  calendarEventId String?
  cancelTokenHash String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId, start])
  @@index([bookingPageId, start])
}

model Board {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  icon        String? // emoji
  position    Float         @default(0)
  // "manual" columns, or auto-group by status | priority | project | tag.
  groupBy     String        @default("manual")
  columns     BoardColumn[]
  tasks       Task[]
  savedViews  SavedView[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model BoardColumn {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  position   Float    @default(0)
  // For auto-grouped boards, the derived value this column maps to (e.g. a
  // status or priority value). Null for manual columns.
  mappingKey String?
  tasks      Task[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([boardId])
}

model SavedView {
  id           String              @id @default(cuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId  String?
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  boardId      String?
  board        Board?              @relation(fields: [boardId], references: [id], onDelete: SetNull)
  name         String              @default("Saved view")
  visibility   SavedViewVisibility @default(PERSONAL)
  resource     SavedViewResource   @default(TASKS)
  queryVersion Int                 @default(1)
  // table | board | list | timeline | calendar | gallery
  type         String
  groupBy      String?
  filters      Json?
  sort         Json?
  position     Float               @default(0)
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
  @@index([workspaceId, resource, archivedAt, position])
  @@index([workspaceId, visibility, archivedAt])
  @@index([boardId])
}

/// A personal, block-based document. Pages are deliberately independent from
/// Task so notebooks and databases never become a parallel scheduling system.
model Page {
  id                    String                     @id @default(cuid())
  userId                String?
  user                  User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId           String?
  workspace             Workspace?                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parentId              String?
  parent                Page?                      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              Page[]                     @relation("PageTree")
  folderId              String?
  folder                PageFolder?                @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags                  PageTag[]
  title                 String                     @default("Untitled")
  icon                  String?
  coverUrl              String?
  isPrivate             Boolean                    @default(false)
  isFavorite            Boolean                    @default(false)
  createdBy             PageAuthor                 @default(HUMAN)
  trashedAt             DateTime?
  position              Float                      @default(0)
  documentFormatVersion Int                        @default(1)
  contentRevision       Int                        @default(0)
  blocks                PageBlock[]
  database              PageDatabase?
  record                DatabaseRecord?
  revisions             PageRevision[]
  aiProposals           AiPageChangeProposal[]
  meetingNoteProposals  MeetingNoteProposal[]
  assets                PageAsset[]
  comments              PageComment[]
  forms                 PageForm[]
  accessGrants          PageAccessGrant[]
  collaborationState    PageCollaborationState?
  collaborationSessions PageCollaborationSession[]
  publication           PagePublication?
  // First-run example; see Task.isSample.
  isSample              Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  // Design v3: document style (backdrop, page, text, font, ...) and its project.
  style                 Json?
  projectId             String?
  project               Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  views                 PageView[]
  aiAccess              PageAiAccess[]

  @@index([userId, parentId, position])
  @@index([workspaceId])
  @@index([folderId])
  @@index([userId, isFavorite])
  @@index([userId, trashedAt])
  @@index([projectId])
}

/// A workspace-scoped Page collection. Moving a Page never changes its
/// permissions or document identity.
model PageFolder {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  color       String?
  position    Float      @default(0)
  archivedAt  DateTime?
  pages       Page[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, archivedAt, position])
  @@index([userId, archivedAt])
}

/// Labels are workspace-scoped. Archiving a label never removes it from a
/// historical Page record.
model PageTag {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  color       String?
  archivedAt  DateTime?
  pages       Page[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, archivedAt])
  @@index([userId, archivedAt])
}

/// A user-owned, workspace-bound saved Page query. queryVersion prevents a
/// future filter change from silently reinterpreting an existing Smart Folder.
model PageSmartFolder {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  queryVersion Int        @default(1)
  query        Json
  position     Float      @default(0)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId, archivedAt, position])
  @@index([userId, archivedAt])
}

model PageBlock {
  id            String        @id @default(cuid())
  pageId        String
  page          Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
