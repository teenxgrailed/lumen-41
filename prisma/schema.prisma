  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model PageCollaborationSession {
  pageId    String
  sessionId String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
