  position   Float            @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([databaseId, position])
}

model PageRevision {
  id        String     @id @default(cuid())
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  snapshot  Json
  createdBy PageAuthor @default(HUMAN)
  createdAt DateTime   @default(now())

  @@index([pageId, createdAt])
  @@index([userId, createdAt])
}

model PageAccessGrant {
  id          String         @id @default(cuid())
  pageId      String
  page        Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("PageAccessGrantee", fields: [userId], references: [id], onDelete: Cascade)
  role        PageAccessRole
  grantedById String?
  grantedBy   User?          @relation("PageAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([pageId, userId])
  @@index([userId, role])
  @@index([grantedById])
}

model PageCollaborationState {
  id        String   @id @default(cuid())
  pageId    String   @unique
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
