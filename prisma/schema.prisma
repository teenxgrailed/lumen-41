  position   Float                @default(0)
  values     DatabaseValue[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([databaseId, position])
}

model DatabaseRecord {
  id         String          @id @default(cuid())
  databaseId String
  database   PageDatabase    @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  pageId     String          @unique
  page       Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position   Float           @default(0)
  values     DatabaseValue[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([databaseId, position])
}

model DatabaseValue {
  id         String           @id @default(cuid())
  recordId   String
  record     DatabaseRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  propertyId String
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  value      Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([recordId, propertyId])
  @@index([propertyId])
}

model DatabaseView {
  id         String           @id @default(cuid())
  databaseId String
