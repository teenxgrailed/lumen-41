{
  "name": "needt",
  "description": "Needt: AI Planner, Tasks, Docs",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "agent:context": "node scripts/agent-context.mjs",
    "changelog:collect": "node scripts/changelog-collect.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "whats-new": "tsx scripts/whats-new.ts",
    "predev": "tsx scripts/whats-new.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/whats-new.ts",
    "build": "next build",
    "postbuild": "node scripts/check-production-artifacts.mjs",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker/index.js --external:@prisma/client --external:.prisma --external:@block65/webcrypto-web-push",
    "build:collaboration": "esbuild src/collaboration/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/collaboration/index.mjs --external:@prisma/client --external:.prisma --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\"",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run build",
    "start": "next start",
    "start:worker": "node dist/worker/index.js",
    "start:collaboration": "node dist/collaboration/index.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test:unit": "TZ=UTC jest",
    "test:e2e": "tsx scripts/reset-e2e-environment.ts && playwright test",
    "test:visual": "tsx scripts/reset-e2e-environment.ts && playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "tsx scripts/update-visual-baselines.ts",
    "test:style": "playwright test --config=playwright.style.config.ts",
    "test:style:update": "playwright test --config=playwright.style.config.ts --update-snapshots=all",
    "mcp:needt": "node mcp/needt-mcp-server.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "check:changelog": "node scripts/check-changelog-edit.mjs",
    "check:agent-handoffs": "node scripts/check-agent-handoffs.mjs",
    "check:collaboration-runtime": "node scripts/check-collaboration-runtime.mjs",
    "check:runtime-shas": "node scripts/check-runtime-shas.mjs",
    "check:worker-bundle": "node scripts/check-worker-bundle.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts-admin-settings-fixtures.mjs && node scripts/check-ui-contracts.mjs",
    "prisma:generate": "prisma generate",
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "tokens:sync:v3": "node scripts/sync-design-tokens.mjs --scope .needt-v3 --out src/styles/v3",
    "prisma:studio": "prisma studio",
    "clean": "rm -rf .next node_modules",
    "db:up": "docker compose up db -d",
    "verify:needt-data-layer": "tsx scripts/verify-needt-data-layer.ts",
    "start:prod": "infisical run --token=\"$INFISICAL_TOKEN\" --projectId=\"$PROJECT_ID\" --env=\"$INFISICAL_SECRET_ENV\" --domain=\"$INFISICAL_API_URL\" -- next start",
    "prisma:update": "infisical run --token=\"$INFISICAL_TOKEN\" --projectId=\"$PROJECT_ID\" --env=\"$INFISICAL_SECRET_ENV\" --domain=\"$INFISICAL_API_URL\" -- npx prisma generate && infisical run --token=\"$INFISICAL_TOKEN\" --projectId=\"$PROJECT_ID\" --env=\"$INFISICAL_SECRET_ENV\" --domain=\"$INFISICAL_API_URL\" -- npx prisma migrate deploy",
    "docker:publish": "docker build -t ghcr.io/teenxgrailed/needt:main -f docker/production/Dockerfile . && docker push ghcr.io/teenxgrailed/needt:main",
    "prepare": "husky",
    "tokens:check": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.7.4",
    "@block65/webcrypto-web-push": "^1.0.2",
    "@creem_io/nextjs": "^0.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@formkit/auto-animate": "^0.10.0",
    "@hocuspocus/extension-redis": "^4.5.0",
    "@hocuspocus/provider": "^4.5.0",
    "@hocuspocus/server": "^4.5.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-query-devtools": "^5.74.6",
    "@tiptap/extension-collaboration": "^3.28.0",
    "@tiptap/extension-collaboration-caret": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/markdown": "3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/y-tiptap": "^3.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.9",
    "canvas-confetti": "^1.9.3",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "creem": "^1.5.4",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "gaxios": "^7.1.6",
    "googleapis": "^144.0.0",
    "ical.js": "^2.1.0",
    "imapflow": "^1.4.7",
    "ioredis": "^5.6.0",
    "isomorphic-dompurify": "2.26.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.42.2",
    "next": "^15.5.28",
    "next-auth": "^4.24.11",
    "pg": "^8.13.3",
    "postal-mime": "^2.7.5",
    "prisma": "^6.3.1",
    "react": "^19.0.3",
    "react-day-picker": "^9.6.7",
    "react-dom": "^19.0.3",
    "react-icons": "^5.4.0",
    "resend": "^4.1.2",
    "rrule": "^2.8.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdav": "^2.1.3",
    "uuid": "^11.0.5",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^3.24.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.50.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8",
    "postcss-selector-parser": "^6.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "y-protocols": "$y-protocols",
    "yjs": "$yjs",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "npm run type-check"
    ]
  }
}
