exports[`email templates account-export matches its snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Your Needt data export is ready</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark;}
body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;}
img{-ms-interpolation-mode:bicubic;border:0;outline:none;text-decoration:none;}
@media (prefers-color-scheme:dark){
.paper{background-color:#151412 !important;}
.card{background-color:#1f1e1b !important;border-color:#33312d !important;}
.well{background-color:#2a2926 !important;}
.hair{border-color:#33312d !important;}
.ink{color:#ece8e1 !important;}
.body{color:#cdc9c0 !important;}
.muted,.muted a{color:#a8a399 !important;}
.btn{background-color:#ece8e1 !important;border-color:#ece8e1 !important;}
.btn-a{color:#1b1a17 !important;}
}
[data-ogsb] .paper{background-color:#151412 !important;}
[data-ogsb] .card{background-color:#1f1e1b !important;border-color:#33312d !important;}
[data-ogsb] .well{background-color:#2a2926 !important;}
[data-ogsb] .hair{border-color:#33312d !important;}
[data-ogsc] .ink{color:#ece8e1 !important;}
[data-ogsc] .body{color:#cdc9c0 !important;}
[data-ogsc] .muted,[data-ogsc] .muted a{color:#a8a399 !important;}
[data-ogsb] .btn{background-color:#ece8e1 !important;border-color:#ece8e1 !important;}
[data-ogsc] .btn-a{color:#1b1a17 !important;}
@media only screen and (max-width:600px){
.wrap{width:100% !important;}
.gutter{padding:20px 16px !important;}
.pad{padding:24px 20px !important;}
.code{font-size:28px !important;letter-spacing:4px !important;}
}
</style>
</head>
<body class="paper" bgcolor="#f7f7f8" style="margin:0;padding:0;background-color:#f7f7f8;width:100%;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">The download link works once and expires in 24 hours.&#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; </div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="paper" bgcolor="#f7f7f8" style="background-color:#f7f7f8;">
<tr><td align="center" class="paper gutter" bgcolor="#f7f7f8" style="padding:32px 24px;background-color:#f7f7f8;">
<!--[if mso]><table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" align="center"><tr><td><![endif]-->
<table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" class="wrap" style="width:100%;max-width:560px;">
<tr><td class="card pad" bgcolor="#fefefe" style="background-color:#fefefe;border:1px solid #e6e6e9;border-radius:12px;padding:32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px 0;"><tr><td bgcolor="#fefefe" style="padding:0;background-color:#fefefe;border:1px solid #e6e6e9;border-radius:8px;line-height:0;font-size:0;"><img src="https://needt.app/icon-192.png" width="30" height="30" alt="Needt" style="display:block;width:30px;height:30px;border:0;border-radius:7px;color:#1b1a17;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:30px;"></td></tr></table>
<h1 class="ink" style="margin:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:21px;line-height:28px;font-weight:600;letter-spacing:-0.2px;color:#1b1a17;">Your data export is ready</h1>
<p class="body" style="margin:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:22px;color:#47453f;">Your account archive is ready to download.</p><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://use.needt.app/api/account/export/download?token=SAMPLE" style="height:44px;v-text-anchor:middle;width:245px;" arcsize="18%" stroke="f" fillcolor="#1b1a17"><w:anchorlock/><center style="color:#fefefe;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">Download your archive</center></v:roundrect><![endif]--><!--[if !mso]><!--><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:8px 0 12px 0;"><tr><td class="btn" align="center" bgcolor="#1b1a17" style="background-color:#1b1a17;border:1px solid #1b1a17;border-radius:8px;"><a href="https://use.needt.app/api/account/export/download?token=SAMPLE" class="btn-a" target="_blank" style="display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#fefefe;text-decoration:none;">Download your archive</a></td></tr></table><!--<![endif]--><p class="muted" style="margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6e6b64;">Button not working? Paste this link into your browser:<br><a href="https://use.needt.app/api/account/export/download?token=SAMPLE" class="muted" target="_blank" style="color:#6e6b64;word-break:break-all;">https://use.needt.app/api/account/export/download?token=SAMPLE</a></p><p class="muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6e6b64;">This one-use link expires in 24 hours.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 0 0;"><tr><td class="hair" style="padding:16px 0 0 0;border-top:1px solid #e6e6e9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;"><p class="muted" style="margin:0 0 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6e6b64;">You get this because of activity on your Needt account.</p><p class="muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6e6b64;">Needt &middot; needt.app</p></td></tr></table>
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>",
  "subject": "Your Needt data export is ready",
  "text": "Your data export is ready

Your account archive is ready to download.

Download your archive: https://use.needt.app/api/account/export/download?token=SAMPLE

This one-use link expires in 24 hours.

--
You get this because of activity on your Needt account.
Needt - needt.app",
}
`;

