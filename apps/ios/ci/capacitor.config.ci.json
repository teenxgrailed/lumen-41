{
  "appId": "app.needt.ios",
  "appName": "Needt",
  "webDir": "www",
  "backgroundColor": "#141416",
  "server": {
    "url": "http://127.0.0.1:3001/",
    "allowNavigation": ["127.0.0.1"],
    "cleartext": true
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Needt"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "launchFadeOutDuration": 200
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  }
}
