{
  "appId": "app.needt.ios",
  "appName": "Needt",
  "webDir": "www",
  "backgroundColor": "#141416",
  "server": {
    "url": "https://use.needt.app",
    "allowNavigation": ["use.needt.app", "*.needt.app", "needt.app"],
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Needt"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "launchFadeOutDuration": 200
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  }
}
